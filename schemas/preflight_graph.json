{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unified Preflight Graph Result",
  "description": "Canonical schema for unified preflight decision graph: Policy -> Hook -> Drift -> Gate -> Push",
  "type": "object",
  "required": ["execution_id", "timestamp", "graph", "summary"],
  "properties": {
    "execution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this preflight execution"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 timestamp of execution start"
    },
    "graph": {
      "type": "object",
      "description": "The preflight graph execution results",
      "required": ["policy", "hook", "drift", "gate", "push"],
      "properties": {
        "policy": {
          "type": "object",
          "description": "Policy evaluation step",
          "required": ["status", "duration_ms"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["PASS", "FAIL", "SKIPPED", "NOT_CONFIGURED"]
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "policy_kind": {
              "type": "string"
            },
            "violations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "error": {
              "type": "string"
            }
          }
        },
        "hook": {
          "type": "object",
          "description": "Git hook verification step",
          "required": ["status", "duration_ms"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["PASS", "FAIL", "SKIPPED"]
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "hooks_verified": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        },
        "drift": {
          "type": "object",
          "description": "Dependency drift detection step",
          "required": ["status", "duration_ms"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["PASS", "FAIL", "SKIPPED"]
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "drift_detected": {
              "type": "boolean"
            },
            "drifted_packages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "error": {
              "type": "string"
            }
          }
        },
        "gate": {
          "type": "object",
          "description": "Pre-push gate execution step",
          "required": ["status", "duration_ms"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["PASS", "FAIL", "SKIPPED"]
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "steps": {
              "type": "object",
              "properties": {
                "toolchain": {
                  "type": "string",
                  "enum": ["PASS", "FAIL"]
                },
                "compile": {
                  "type": "string",
                  "enum": ["PASS", "FAIL"]
                },
                "tests": {
                  "type": "string",
                  "enum": ["PASS", "FAIL"]
                },
                "help_surface": {
                  "type": "string",
                  "enum": ["PASS", "FAIL"]
                }
              }
            },
            "error": {
              "type": "string"
            }
          }
        },
        "push": {
          "type": "object",
          "description": "Git push execution step",
          "required": ["status", "duration_ms"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["PENDING", "SENT", "FAILED", "SKIPPED"]
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "branch": {
              "type": "string"
            },
            "remote": {
              "type": "string"
            },
            "commit_sha": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "description": "Failure details (present when overall_status is FAIL)",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Failure code (e.g., E001, P001, H001, D001, G001)",
          "pattern": "^[EPHDG]\\d{3}$"
        },
        "message": {
          "type": "string",
          "description": "Human-readable failure description"
        },
        "remediation": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Step-by-step remediation instructions"
        },
        "evidence": {
          "type": "object",
          "properties": {
            "log_file": {
              "type": "string",
              "format": "uri"
            },
            "artifact": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_duration_ms", "overall_status"],
      "properties": {
        "total_duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "overall_status": {
          "type": "string",
          "enum": ["PASS", "FAIL"]
        },
        "retryable": {
          "type": "boolean",
          "description": "Whether the failure is retryable (transient)"
        },
        "continue_on_failure": {
          "type": "boolean",
          "description": "Whether full graph was executed despite failures"
        }
      }
    }
  }
}
